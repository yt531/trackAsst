rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy / Personal rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /notifications/{notificationId} {
        // 發送者必須是本人（防冒名）；管理員通知僅帳本管理員可建立
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && (request.resource.data.type != 'admin_notice'
              || isLedgerManager(request.resource.data.ledgerId));
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // 收件人可更新自己的通知；管理員通知的發佈管理員可同步編輯／刪除已送出的副本
        allow update: if request.auth != null && (
          request.auth.uid == userId
          || (resource.data.type == 'admin_notice'
              && isLedgerManager(resource.data.ledgerId)));
      }

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Shared Ledger rules
    // 已退出（status == 'left'）的成員不再享有成員／管理權限；舊資料缺 status 視為 active
    function isActiveMemberDoc(m) {
      return m.get('status', 'active') == 'active';
    }

    function isLedgerMember(ledgerId) {
      let path = /databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid);
      return exists(path) && isActiveMemberDoc(get(path).data);
    }

    function isLedgerAdmin(ledgerId) {
      let path = /databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid);
      return exists(path) && isActiveMemberDoc(get(path).data) && get(path).data.role == 'admin';
    }

    // 管理員 = admin 或 vice_admin
    function isLedgerManager(ledgerId) {
      let path = /databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid);
      return exists(path) && isActiveMemberDoc(get(path).data) && get(path).data.role in ['admin', 'vice_admin'];
    }

    // 邀請碼是否可用來以 role 加入 ledgerId（加入者須在成員文件寫入 inviteCode）
    function isValidInvite(ledgerId, inviteCode, role) {
      let inv = get(/databases/$(database)/documents/ledgerInvitations/$(inviteCode)).data;
      return inv.ledgerId == ledgerId
        && inv.status == 'active'
        && inv.expiresAt > request.time.toMillis()
        && inv.defaultRole == role
        && (!('targetEmailOrId' in inv) || inv.targetEmailOrId == null
            || inv.targetEmailOrId.lower() == request.auth.token.email.lower());
    }

    // 核准待審交易（同一批次內該筆交易由 pending 變 approved，核准人為本人且非送審人，
    // 並有使用餘額折抵）。用來讓「核准人」在核准批次中扣抵繳款人餘額、寫入餘額紀錄
    function isApprovingTx(ledgerId, txId) {
      let txPath = /databases/$(database)/documents/ledgers/$(ledgerId)/transactions/$(txId);
      return exists(txPath) && existsAfter(txPath)
        && get(txPath).data.approvalStatus == 'pending'
        && getAfter(txPath).data.approvalStatus == 'approved'
        && getAfter(txPath).data.approvedBy == request.auth.uid
        && get(txPath).data.userId != request.auth.uid
        && getAfter(txPath).data.get('usedBalance', 0) > 0;
    }

    // 成員文件的餘額異動：必須是該筆交易的繳款人，且新餘額 = 原餘額 − min(折抵金額, 原餘額)
    function isApprovalDeduction(ledgerId, memberId) {
      let txId = request.resource.data.balanceTxId;
      let txPath = /databases/$(database)/documents/ledgers/$(ledgerId)/transactions/$(txId);
      let used = getAfter(txPath).data.get('usedBalance', 0);
      let bal = resource.data.get('balance', 0);
      return isLedgerMember(ledgerId)
        && isApprovingTx(ledgerId, txId)
        && getAfter(txPath).data.payerId == memberId
        && request.resource.data.balance == bal - (used < bal ? used : bal);
    }

    // 餘額紀錄：必須對應同一批次的核准，且繳款人與金額與實際扣抵一致
    function isApprovalLog(ledgerId) {
      let txId = request.resource.data.relatedTransactionId;
      let txPath = /databases/$(database)/documents/ledgers/$(ledgerId)/transactions/$(txId);
      let payerId = getAfter(txPath).data.payerId;
      let payerPath = /databases/$(database)/documents/ledgers/$(ledgerId)/members/$(payerId);
      let used = getAfter(txPath).data.get('usedBalance', 0);
      let bal = get(payerPath).data.get('balance', 0);
      return isLedgerMember(ledgerId)
        && isApprovingTx(ledgerId, txId)
        && request.resource.data.userId == payerId
        && request.resource.data.amount == (used < bal ? used : bal);
    }

    // Allow collectionGroup('members') queries
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /ledgers/{ledgerId} {
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow read: if isLedgerMember(ledgerId);
      allow update, delete: if isLedgerAdmin(ledgerId);
      
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if isLedgerAdmin(ledgerId) || (
          request.auth.uid == memberId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'active'
          && (
            // 帳本建立者建立自己為第一位管理員
            (get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.createdBy == request.auth.uid
              && request.resource.data.role == 'admin')
            // 或憑有效邀請碼以邀請指定的角色加入
            || isValidInvite(ledgerId, request.resource.data.inviteCode, request.resource.data.role)
          )
        );
        allow update: if isLedgerAdmin(ledgerId)
          // 副管理員核准繳款時需扣抵成員餘額，但只能動 balance，不可改 role 等其他欄位
          || (isLedgerManager(ledgerId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']))
          // 核准繳款的人（可能只是一般成員）扣抵繳款人餘額：須與同一批次的核准交易相符
          || ('balanceTxId' in request.resource.data
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'balanceTxId'])
            && isApprovalDeduction(ledgerId, memberId))
          || (
          request.auth.uid == memberId && (
            // 本人只能改暱稱、通知偏好，或把自己標為退出，不可改 role
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'notificationPreferences', 'status'])
              && request.resource.data.status in [resource.data.status, 'left'])
            // 已退出者憑有效邀請碼重新加入
            || (resource.data.status == 'left'
              && request.resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'joinedAt', 'nickname', 'inviteCode'])
              && isValidInvite(ledgerId, request.resource.data.inviteCode, request.resource.data.role))
          )
        );
        allow delete: if isLedgerAdmin(ledgerId) || request.auth.uid == memberId;
      }
      
      match /transactions/{transactionId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /categories/{categoryId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /tags/{tagId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /activityFeed/{feedId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      // 管理員通知：僅 viewerIds 內的人與管理員可讀；只能軟刪除（不可真刪）
      match /notices/{noticeId} {
        allow read: if isLedgerManager(ledgerId) || request.auth.uid in resource.data.viewerIds;
        allow create: if isLedgerManager(ledgerId) && request.resource.data.authorId == request.auth.uid;
        allow update: if isLedgerManager(ledgerId) && request.resource.data.authorId == resource.data.authorId;
        allow delete: if false;
      }

      // 公告：全體成員可讀；僅管理員可建立、修改（含取消），不可真刪
      match /announcements/{announcementId} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if isLedgerManager(ledgerId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'active';
        allow update: if isLedgerManager(ledgerId)
          && request.resource.data.authorId == resource.data.authorId;
        allow delete: if false;
      }

      match /collections/{collectionId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /budgets/{budgetId} {
        allow read, write: if isLedgerMember(ledgerId);
      }

      // 成員餘額（溢收款）異動紀錄：僅管理員（含副管理員）可建立且須為本人操作；
      // 成員只能讀自己的，管理員可讀全部；屬稽核紀錄，不可修改或刪除
      match /balanceLogs/{logId} {
        allow read: if isLedgerManager(ledgerId)
          || (isLedgerMember(ledgerId) && resource.data.userId == request.auth.uid);
        allow create: if (isLedgerManager(ledgerId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.ledgerId == ledgerId)
          // 核准繳款時的自動餘額折抵紀錄（核准人可為一般成員）
          || (request.resource.data.createdBy == request.auth.uid
            && request.resource.data.ledgerId == ledgerId
            && request.resource.data.type == 'overpayment_deduct'
            && 'relatedTransactionId' in request.resource.data
            && isApprovalLog(ledgerId));
        allow update, delete: if false;
      }
    }
    
    match /ledgerInvitations/{inviteId} {
      // 只能憑邀請碼單筆讀取，不可列舉全部邀請
      allow get: if request.auth != null;
      allow create: if isLedgerAdmin(request.resource.data.ledgerId)
        && request.resource.data.createdBy == request.auth.uid;
      // 管理員可任意更新（如撤銷）；加入者只能把使用次數 +1（並標記已用完）
      allow update: if isLedgerAdmin(resource.data.ledgerId)
        || (isLedgerMember(resource.data.ledgerId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usageCount'])
            && request.resource.data.usageCount == resource.data.usageCount + 1
            && request.resource.data.status in ['active', 'used']);
      allow delete: if isLedgerAdmin(resource.data.ledgerId);
    }
  }
}

// Force update 2026-08-18
