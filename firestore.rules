rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy / Personal rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /notifications/{notificationId} {
        // 發送者必須是本人（防冒名）；管理員通知僅帳本管理員可建立
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && (request.resource.data.type != 'admin_notice'
              || isLedgerManager(request.resource.data.ledgerId));
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // 收件人可更新自己的通知；管理員通知的發佈管理員可同步編輯／刪除已送出的副本
        allow update: if request.auth != null && (
          request.auth.uid == userId
          || (resource.data.type == 'admin_notice'
              && isLedgerManager(resource.data.ledgerId)));
      }

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Shared Ledger rules
    function isLedgerMember(ledgerId) {
      return exists(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid));
    }
    
    function isLedgerAdmin(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    
    // 管理員 = admin 或 vice_admin
    function isLedgerManager(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid)).data.role in ['admin', 'vice_admin'];
    }

    // Allow collectionGroup('members') queries
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /ledgers/{ledgerId} {
      allow create: if request.auth != null;
      allow read: if isLedgerMember(ledgerId);
      allow update, delete: if isLedgerAdmin(ledgerId);
      
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if isLedgerAdmin(ledgerId) || request.auth.uid == memberId;
      }
      
      match /transactions/{transactionId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /categories/{categoryId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /tags/{tagId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /activityFeed/{feedId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      // 管理員通知：僅 viewerIds 內的人與管理員可讀；只能軟刪除（不可真刪）
      match /notices/{noticeId} {
        allow read: if isLedgerManager(ledgerId) || request.auth.uid in resource.data.viewerIds;
        allow create: if isLedgerManager(ledgerId) && request.resource.data.authorId == request.auth.uid;
        allow update: if isLedgerManager(ledgerId) && request.resource.data.authorId == resource.data.authorId;
        allow delete: if false;
      }

      // 公告：全體成員可讀；僅管理員可建立、修改（含取消），不可真刪
      match /announcements/{announcementId} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if isLedgerManager(ledgerId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'active';
        allow update: if isLedgerManager(ledgerId)
          && request.resource.data.authorId == resource.data.authorId;
        allow delete: if false;
      }

      match /collections/{collectionId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
      
      match /budgets/{budgetId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
    }
    
    match /ledgerInvitations/{inviteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

